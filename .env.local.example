# OpenAI Realtime (server-only)
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin

# Supabase (server-only — never expose service role key to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_RECORDINGS_BUCKET=recordings

# Supabase (browser-safe)
# Get from Supabase project settings → API → publishable anon key.
# Server-only keys remain server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Gemini (server-only — used for video analysis)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-pro

# Stripe billing (phase C — server-only). The lazy singleton in
# lib/billing/stripe.ts throws a friendly error if the secret is REPLACE_ME
# or absent, so the build succeeds even when these aren't set locally.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_STARTER_PRICE_ID=price_REPLACE_ME
STRIPE_PRO_PRICE_ID=price_REPLACE_ME
STRIPE_STARTER_OVERAGE_METER_ID=price_REPLACE_ME
STRIPE_PRO_OVERAGE_METER_ID=price_REPLACE_ME

# Public app origin (used in Stripe success/cancel redirects + invite emails)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
